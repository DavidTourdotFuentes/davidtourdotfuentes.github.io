{
  "sharedBanks": ["Master.bank", "Master.strings.bank"],
  "demos": [
    {
      "id": "darkest-canopy",
      "name": "lab_dc_name",
      "project": "Darkest Canopy",
      "image": "../ressources/DarkestCanopy/Lab.jpg",
      "title": "lab_dc_title",
      "description": "lab_dc_text",
      "steps": [
        { "text": "lab_dc_step1", "when": "play" },
        { "text": "lab_dc_step2", "when": "param", "value": 100 },
        { "text": "lab_dc_step3", "when": "param", "value": 0 }
      ],
      "observation": "lab_dc_observation",
      "banks": ["DarkestCanopy.bank"],
      "events": [
        {
          "path": "event:/DarkestCanopy/Music",
          "label": "lab_event_music",
          "mode": "loop",
          "parameters": [
            {
              "name": "ExplorationOrFight_param",
              "label": "lab_dc_param",
              "type": "toggle",
              "global": true,
              "labels": ["lab_dc_explore", "lab_dc_fight"],
              "values": [0, 100]
            }
          ]
        }
      ]
    },
    {
      "id": "hide-and-flee-monster",
      "name": "lab_hm_name",
      "project": "Hide And Flee",
      "image": "../ressources/HideAndFlee/Lab_Tension.jpg",
      "title": "lab_hm_title",
      "description": "lab_hm_text",
      "steps": [
        { "text": "lab_hm_step1", "when": "play" },
        { "text": "lab_hm_step2", "when": "param", "below": 10 },
        { "text": "lab_hm_step3", "when": "param", "above": 80 }
      ],
      "observation": "lab_hm_observation",
      "banks": ["HideAndFlee.bank"],
      "events": [
        {
          "path": "event:/HideAndFlee/Monster Proximity",
          "label": "lab_event_ambience",
          "mode": "loop",
          "parameters": [
            {
              "name": "EyesDistance_param",
              "label": "lab_hm_param",
              "type": "continuous",
              "global": true,
              "min": 0,
              "max": 100,
              "step": 1,
              "default": 100,
              "reversed": true,
              "ends": ["lab_hm_far", "lab_hm_near"]
            }
          ]
        }
      ]
    },
    {
      "id": "hide-and-flee-music",
      "name": "lab_hp_name",
      "project": "Hide And Flee",
      "image": "../ressources/HideAndFlee/Lab_Progression.jpg",
      "title": "lab_hp_title",
      "description": "lab_hp_text",
      "steps": [
        { "text": "lab_hp_step1", "when": "play" },
        { "text": "lab_hp_step2", "when": "param", "count": 2 },
        { "text": "lab_hp_step3", "when": "param", "value": 5 }
      ],
      "observation": "lab_hp_observation",
      "banks": ["HideAndFlee.bank"],
      "events": [
        {
          "path": "event:/HideAndFlee/Music",
          "label": "lab_event_music",
          "mode": "loop",
          "parameters": [
            {
              "name": "LevelStage_param",
              "label": "lab_hp_param",
              "type": "stepped",
              "sequential": true,
              "global": true,
              "min": 1,
              "labels": ["lab_hp_stage1", "lab_hp_stage2", "lab_hp_stage3", "lab_hp_stage4", "lab_hp_stage5"]
            }
          ]
        }
      ]
    },
    {
      "id": "explosion",
      "name": "lab_ex_name",
      "title": "lab_ex_title",
      "description": "lab_ex_text",
      "steps": [
        { "text": "lab_ex_step1", "when": "play", "below": 25 },
        { "text": "lab_ex_step2", "when": "play", "above": 65 },
        { "text": "lab_ex_step3", "when": "move" }
      ],
      "observation": "lab_ex_observation",
      "banks": ["Explosion.bank"],
      "events": [
        {
          "path": "event:/Explosion/Explode",
          "label": "lab_event_explode",
          "mode": "oneshot",
          "spatial": { "distance": [10, 100] }
        }
      ]
    }
  ]
}
